<?xml version="1.0" encoding="UTF-8"?>
<POWERMART CREATION_DATE="07/10/2026 10:00:00" REPOSITORY_VERSION="186">
  <REPOSITORY NAME="CARS_REPO" VERSION="186" CODEPAGE="UTF-8">
    <FOLDER NAME="UsedCarsETL" GROUP="" OWNER="etl_admin" SHARED="NOTSHARED">

      <!-- ── Source table definitions ─────────────────────────────── -->
      <SOURCE NAME="SRC_CAR" DBDNAME="CARS_ORACLE" DATABASETYPE="Oracle">
        <SOURCEFIELD NAME="CAR_ID" DATATYPE="number" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <SOURCEFIELD NAME="MAKE_CODE" DATATYPE="varchar2" PRECISION="10" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="MODEL_NAME" DATATYPE="varchar2" PRECISION="50" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="MODEL_YEAR" DATATYPE="number" PRECISION="4" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="FUEL_TYPE" DATATYPE="varchar2" PRECISION="20" NULLABLE="NULL"/>
      </SOURCE>

      <SOURCE NAME="SRC_CAR_MAKE" DBDNAME="CARS_ORACLE" DATABASETYPE="Oracle">
        <SOURCEFIELD NAME="MAKE_CODE" DATATYPE="varchar2" PRECISION="10" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <SOURCEFIELD NAME="MAKE_NAME" DATATYPE="varchar2" PRECISION="50" NULLABLE="NULL"/>
      </SOURCE>

      <SOURCE NAME="SRC_SELLER" DBDNAME="CARS_ORACLE" DATABASETYPE="Oracle">
        <SOURCEFIELD NAME="SELLER_ID" DATATYPE="number" PRECISION="10" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <SOURCEFIELD NAME="SELLER_NAME" DATATYPE="varchar2" PRECISION="100" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="SELLER_TYPE_CD" DATATYPE="varchar2" PRECISION="10" NULLABLE="NULL"/>
      </SOURCE>

      <SOURCE NAME="SRC_LISTING" DBDNAME="CARS_ORACLE" DATABASETYPE="Oracle">
        <SOURCEFIELD NAME="LISTING_ID" DATATYPE="number" PRECISION="10" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <SOURCEFIELD NAME="CAR_ID" DATATYPE="number" PRECISION="10" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="SELLER_ID" DATATYPE="number" PRECISION="10" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="LIST_PRICE" DATATYPE="number" PRECISION="10" SCALE="2" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="LISTED_DATE" DATATYPE="date" NULLABLE="NULL"/>
      </SOURCE>

      <!-- ── Target (warehouse) table definitions ─────────────────── -->
      <TARGET NAME="dim_car" DATABASETYPE="Postgres" TABLEOPTIONS="">
        <TARGETFIELD NAME="car_key" DATATYPE="integer" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="brand" DATATYPE="varchar" PRECISION="50" NULLABLE="NULL"/>
        <TARGETFIELD NAME="model" DATATYPE="varchar" PRECISION="50" NULLABLE="NULL"/>
        <TARGETFIELD NAME="model_year" DATATYPE="integer" NULLABLE="NULL"/>
        <TARGETFIELD NAME="fuel_type" DATATYPE="varchar" PRECISION="20" NULLABLE="NULL"/>
        <TARGETFIELD NAME="age_bracket" DATATYPE="varchar" PRECISION="20" NULLABLE="NULL"/>
      </TARGET>

      <TARGET NAME="dim_seller" DATABASETYPE="Postgres" TABLEOPTIONS="">
        <TARGETFIELD NAME="seller_key" DATATYPE="integer" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="seller_name" DATATYPE="varchar" PRECISION="100" NULLABLE="NULL"/>
        <TARGETFIELD NAME="seller_type" DATATYPE="varchar" PRECISION="20" NULLABLE="NULL"/>
      </TARGET>

      <TARGET NAME="fact_car_listings" DATABASETYPE="Postgres" TABLEOPTIONS="">
        <TARGETFIELD NAME="listing_id" DATATYPE="integer" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="car_key" DATATYPE="integer" NULLABLE="NULL"/>
        <TARGETFIELD NAME="seller_key" DATATYPE="integer" NULLABLE="NULL"/>
        <TARGETFIELD NAME="price" DATATYPE="numeric" PRECISION="20" SCALE="6" NULLABLE="NULL"/>
        <TARGETFIELD NAME="listed_date" DATATYPE="date" NULLABLE="NULL"/>
      </TARGET>

      <!-- ── Mapping 1: dim_car — Expression transformation with a real
           derivation (MODEL_YEAR -> age_bracket), plus one deliberately
           unmapped column (fuel_type has no incoming connector, to test
           gap detection) ─────────────────────────────────────────── -->
      <MAPPING NAME="m_load_dim_car">
        <TRANSFORMATION NAME="SQ_SRC_CAR" TYPE="Source Qualifier">
          <TRANSFORMFIELD NAME="CAR_ID" PORTTYPE="OUTPUT" DATATYPE="number"/>
          <TRANSFORMFIELD NAME="MAKE_CODE" PORTTYPE="OUTPUT" DATATYPE="varchar2"/>
          <TRANSFORMFIELD NAME="MODEL_NAME" PORTTYPE="OUTPUT" DATATYPE="varchar2"/>
          <TRANSFORMFIELD NAME="MODEL_YEAR" PORTTYPE="OUTPUT" DATATYPE="number"/>
        </TRANSFORMATION>
        <TRANSFORMATION NAME="SQ_SRC_CAR_MAKE" TYPE="Source Qualifier">
          <TRANSFORMFIELD NAME="MAKE_CODE" PORTTYPE="OUTPUT" DATATYPE="varchar2"/>
          <TRANSFORMFIELD NAME="MAKE_NAME" PORTTYPE="OUTPUT" DATATYPE="varchar2"/>
        </TRANSFORMATION>
        <TRANSFORMATION NAME="LKP_CAR_MAKE" TYPE="Lookup Procedure">
          <TABLEATTRIBUTE NAME="Lookup table name" VALUE="CAR_MAKE"/>
          <TRANSFORMFIELD NAME="MAKE_CODE_IN" PORTTYPE="INPUT" DATATYPE="varchar2"/>
          <TRANSFORMFIELD NAME="MAKE_NAME_OUT" PORTTYPE="OUTPUT" DATATYPE="varchar2"/>
        </TRANSFORMATION>
        <TRANSFORMATION NAME="EXP_DIM_CAR" TYPE="Expression">
          <TRANSFORMFIELD NAME="CAR_ID" PORTTYPE="INPUT" DATATYPE="number"/>
          <TRANSFORMFIELD NAME="MODEL_NAME" PORTTYPE="INPUT" DATATYPE="varchar2"/>
          <TRANSFORMFIELD NAME="MODEL_YEAR" PORTTYPE="INPUT" DATATYPE="number"/>
          <TRANSFORMFIELD NAME="MAKE_NAME_OUT" PORTTYPE="INPUT" DATATYPE="varchar2"/>
          <TRANSFORMFIELD NAME="car_key" PORTTYPE="OUTPUT" DATATYPE="integer" EXPRESSION="TO_INTEGER(CAR_ID)"/>
          <TRANSFORMFIELD NAME="model" PORTTYPE="OUTPUT" DATATYPE="varchar" EXPRESSION="MODEL_NAME"/>
          <TRANSFORMFIELD NAME="model_year" PORTTYPE="OUTPUT" DATATYPE="integer" EXPRESSION="MODEL_YEAR"/>
          <TRANSFORMFIELD NAME="brand" PORTTYPE="OUTPUT" DATATYPE="varchar" EXPRESSION="MAKE_NAME_OUT"/>
          <TRANSFORMFIELD NAME="age_bracket" PORTTYPE="OUTPUT" DATATYPE="varchar"
            EXPRESSION="IIF(MODEL_YEAR &gt;= 2020, 'New', IIF(MODEL_YEAR &gt;= 2015, 'Recent', 'Older'))"/>
        </TRANSFORMATION>

        <INSTANCE NAME="SRC_CAR" TRANSFORMATION_NAME="SQ_SRC_CAR" TRANSFORMATION_TYPE="Source Qualifier"/>
        <INSTANCE NAME="SRC_CAR_MAKE" TRANSFORMATION_NAME="SQ_SRC_CAR_MAKE" TRANSFORMATION_TYPE="Source Qualifier"/>
        <INSTANCE NAME="LKP_CAR_MAKE" TRANSFORMATION_NAME="LKP_CAR_MAKE" TRANSFORMATION_TYPE="Lookup Procedure"/>
        <INSTANCE NAME="EXP_DIM_CAR" TRANSFORMATION_NAME="EXP_DIM_CAR" TRANSFORMATION_TYPE="Expression"/>
        <INSTANCE NAME="dim_car" TRANSFORMATION_NAME="dim_car" TRANSFORMATION_TYPE="Target Definition"/>

        <CONNECTOR FROMINSTANCE="SRC_CAR" FROMFIELD="CAR_ID" TOINSTANCE="EXP_DIM_CAR" TOFIELD="CAR_ID"/>
        <CONNECTOR FROMINSTANCE="SRC_CAR" FROMFIELD="MODEL_NAME" TOINSTANCE="EXP_DIM_CAR" TOFIELD="MODEL_NAME"/>
        <CONNECTOR FROMINSTANCE="SRC_CAR" FROMFIELD="MODEL_YEAR" TOINSTANCE="EXP_DIM_CAR" TOFIELD="MODEL_YEAR"/>
        <CONNECTOR FROMINSTANCE="SRC_CAR" FROMFIELD="MAKE_CODE" TOINSTANCE="LKP_CAR_MAKE" TOFIELD="MAKE_CODE_IN"/>
        <CONNECTOR FROMINSTANCE="LKP_CAR_MAKE" FROMFIELD="MAKE_NAME_OUT" TOINSTANCE="EXP_DIM_CAR" TOFIELD="MAKE_NAME_OUT"/>

        <CONNECTOR FROMINSTANCE="EXP_DIM_CAR" FROMFIELD="car_key" TOINSTANCE="dim_car" TOFIELD="car_key"/>
        <CONNECTOR FROMINSTANCE="EXP_DIM_CAR" FROMFIELD="brand" TOINSTANCE="dim_car" TOFIELD="brand"/>
        <CONNECTOR FROMINSTANCE="EXP_DIM_CAR" FROMFIELD="model" TOINSTANCE="dim_car" TOFIELD="model"/>
        <CONNECTOR FROMINSTANCE="EXP_DIM_CAR" FROMFIELD="model_year" TOINSTANCE="dim_car" TOFIELD="model_year"/>
        <CONNECTOR FROMINSTANCE="EXP_DIM_CAR" FROMFIELD="age_bracket" TOINSTANCE="dim_car" TOFIELD="age_bracket"/>
        <!-- NOTE: fuel_type is intentionally NOT wired to anything here —
             SRC_CAR.FUEL_TYPE exists but was never mapped. This should show
             up as a genuine gap when you run detect_gaps(). -->
      </MAPPING>

      <!-- ── Mapping 2: dim_seller — simple passthrough + a code lookup via
           expression (no separate Lookup transformation this time) ──── -->
      <MAPPING NAME="m_load_dim_seller">
        <TRANSFORMATION NAME="SQ_SRC_SELLER" TYPE="Source Qualifier">
          <TRANSFORMFIELD NAME="SELLER_ID" PORTTYPE="OUTPUT" DATATYPE="number"/>
          <TRANSFORMFIELD NAME="SELLER_NAME" PORTTYPE="OUTPUT" DATATYPE="varchar2"/>
          <TRANSFORMFIELD NAME="SELLER_TYPE_CD" PORTTYPE="OUTPUT" DATATYPE="varchar2"/>
        </TRANSFORMATION>
        <TRANSFORMATION NAME="EXP_DIM_SELLER" TYPE="Expression">
          <TRANSFORMFIELD NAME="SELLER_ID" PORTTYPE="INPUT" DATATYPE="number"/>
          <TRANSFORMFIELD NAME="SELLER_NAME" PORTTYPE="INPUT" DATATYPE="varchar2"/>
          <TRANSFORMFIELD NAME="SELLER_TYPE_CD" PORTTYPE="INPUT" DATATYPE="varchar2"/>
          <TRANSFORMFIELD NAME="seller_key" PORTTYPE="OUTPUT" DATATYPE="integer" EXPRESSION="TO_INTEGER(SELLER_ID)"/>
          <TRANSFORMFIELD NAME="seller_name" PORTTYPE="OUTPUT" DATATYPE="varchar" EXPRESSION="SELLER_NAME"/>
          <TRANSFORMFIELD NAME="seller_type" PORTTYPE="OUTPUT" DATATYPE="varchar"
            EXPRESSION="DECODE(SELLER_TYPE_CD, 'D', 'Dealer', 'P', 'Private', 'Unknown')"/>
        </TRANSFORMATION>

        <INSTANCE NAME="SRC_SELLER" TRANSFORMATION_NAME="SQ_SRC_SELLER" TRANSFORMATION_TYPE="Source Qualifier"/>
        <INSTANCE NAME="EXP_DIM_SELLER" TRANSFORMATION_NAME="EXP_DIM_SELLER" TRANSFORMATION_TYPE="Expression"/>
        <INSTANCE NAME="dim_seller" TRANSFORMATION_NAME="dim_seller" TRANSFORMATION_TYPE="Target Definition"/>

        <CONNECTOR FROMINSTANCE="SRC_SELLER" FROMFIELD="SELLER_ID" TOINSTANCE="EXP_DIM_SELLER" TOFIELD="SELLER_ID"/>
        <CONNECTOR FROMINSTANCE="SRC_SELLER" FROMFIELD="SELLER_NAME" TOINSTANCE="EXP_DIM_SELLER" TOFIELD="SELLER_NAME"/>
        <CONNECTOR FROMINSTANCE="SRC_SELLER" FROMFIELD="SELLER_TYPE_CD" TOINSTANCE="EXP_DIM_SELLER" TOFIELD="SELLER_TYPE_CD"/>

        <CONNECTOR FROMINSTANCE="EXP_DIM_SELLER" FROMFIELD="seller_key" TOINSTANCE="dim_seller" TOFIELD="seller_key"/>
        <CONNECTOR FROMINSTANCE="EXP_DIM_SELLER" FROMFIELD="seller_name" TOINSTANCE="dim_seller" TOFIELD="seller_name"/>
        <CONNECTOR FROMINSTANCE="EXP_DIM_SELLER" FROMFIELD="seller_type" TOINSTANCE="dim_seller" TOFIELD="seller_type"/>
      </MAPPING>

      <!-- ── Mapping 3: fact_car_listings — pure passthrough fact load,
           no Expression transformation at all (direct connectors straight
           from Source Qualifier to Target) ─────────────────────────── -->
      <MAPPING NAME="m_load_fact_car_listings">
        <TRANSFORMATION NAME="SQ_SRC_LISTING" TYPE="Source Qualifier">
          <TRANSFORMFIELD NAME="LISTING_ID" PORTTYPE="OUTPUT" DATATYPE="number"/>
          <TRANSFORMFIELD NAME="CAR_ID" PORTTYPE="OUTPUT" DATATYPE="number"/>
          <TRANSFORMFIELD NAME="SELLER_ID" PORTTYPE="OUTPUT" DATATYPE="number"/>
          <TRANSFORMFIELD NAME="LIST_PRICE" PORTTYPE="OUTPUT" DATATYPE="number"/>
          <TRANSFORMFIELD NAME="LISTED_DATE" PORTTYPE="OUTPUT" DATATYPE="date"/>
        </TRANSFORMATION>

        <INSTANCE NAME="SRC_LISTING" TRANSFORMATION_NAME="SQ_SRC_LISTING" TRANSFORMATION_TYPE="Source Qualifier"/>
        <INSTANCE NAME="fact_car_listings" TRANSFORMATION_NAME="fact_car_listings" TRANSFORMATION_TYPE="Target Definition"/>

        <CONNECTOR FROMINSTANCE="SRC_LISTING" FROMFIELD="LISTING_ID" TOINSTANCE="fact_car_listings" TOFIELD="listing_id"/>
        <CONNECTOR FROMINSTANCE="SRC_LISTING" FROMFIELD="CAR_ID" TOINSTANCE="fact_car_listings" TOFIELD="car_key"/>
        <CONNECTOR FROMINSTANCE="SRC_LISTING" FROMFIELD="SELLER_ID" TOINSTANCE="fact_car_listings" TOFIELD="seller_key"/>
        <CONNECTOR FROMINSTANCE="SRC_LISTING" FROMFIELD="LIST_PRICE" TOINSTANCE="fact_car_listings" TOFIELD="price"/>
        <!-- NOTE: listed_date is also intentionally left unmapped, a second
             gap to confirm detect_gaps() catches gaps across multiple
             mappings/tables, not just the first one. -->
      </MAPPING>

    </FOLDER>
  </REPOSITORY>
</POWERMART>