# ── AIBridge Configuration (Local Postgres — no Supabase) ───────────────────

# AI Provider
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434

# Other AI providers — fill only if you switch later
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Local Postgres ────────────────────────────────────────────────────────────
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# Replace YOUR_PASSWORD with your actual postgres password
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/postgres

# ── DuckDB warehouse ──────────────────────────────────────────────────────────
DUCKDB_PATH=./aibridge.duckdb

# ── JWT Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY=aibridge-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
